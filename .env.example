# The triage agent's model: any endpoint speaking the OpenAI protocol.
# Empty means the runbook triages, and the Incident triage page says so.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_CHAT_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite

# Shared secret for the operator (reset, and no rate limits). Empty refuses reset.
DEMO_WRITE_TOKEN=

CORS_ORIGINS=http://localhost:5271
